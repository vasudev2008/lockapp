# ==============================================================================
# LOCKTITE INDIA PVT LTD — EMPLOYEE LEAVE MANAGEMENT SYSTEM
# Production Environment Configuration Template
# Copy this file to '.env' and populate with your production values.
# ==============================================================================

# 1. APPLICATION ENVIRONMENT & URL
# The single canonical production URL (used for redirects, reports, and links)
APP_URL=https://leave.locktiteindia.com
ENVIRONMENT=production

# 2. PRODUCTION DATABASE CONFIGURATION
# Production PostgreSQL managed database connection string
# Example: postgresql://username:password@hostname:5432/locktite_leave_db
# (If left empty, the application will fallback to local SQLite for offline operations)
DATABASE_URL=postgresql://locktite_admin:ChangeThisPassword123!@dpg-xxxx.render.com/locktite_leave_db

# 3. SECURITY & SESSION MANAGEMENT
# Cryptographic secret used for session signature and tokens (minimum 32 characters)
SECRET_KEY=locktite-leave-mgmt-sec-key-replace-with-secure-random-32char-token

# Session inactivity timeout in minutes (default 60 minutes)
SESSION_TIMEOUT_MINUTES=60

# Rate limiting lockout window for brute-force login attempts (in minutes)
LOGIN_LOCKOUT_MINUTES=15
MAX_LOGIN_ATTEMPTS=5

# 4. CORS & DOMAIN POLICY
# Comma-separated list of allowed origins (or * for all)
CORS_ORIGINS=https://leave.locktiteindia.com,https://www.leave.locktiteindia.com

# 5. SERVER RUNTIME
PORT=8000
HOST=0.0.0.0
